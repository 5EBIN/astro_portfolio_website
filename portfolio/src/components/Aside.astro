---
import { escapeWithLineBreaks } from '../lib/escape-html';

interface Props {
  facts: Record<string, string>;
  links?: { label: string; url: string }[];
}

const { facts, links } = Astro.props;
---

<aside class="aside">
  <dl>
    {Object.entries(facts).map(([term, value]) => (
      <>
        <dt>{term}</dt>
        <dd set:html={escapeWithLineBreaks(value)} />
      </>
    ))}
  </dl>
  {links && links.length > 0 && (
    <div class="actions">
      {links.map((link) => (
        <a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}>
          {link.label}
        </a>
      ))}
    </div>
  )}
</aside>
