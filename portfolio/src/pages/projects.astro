---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import Row from '../components/Row.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Projects — Sebin Shaiju"
  description="Eight builds by Sebin Shaiju across agents, machine learning, full-stack and research, with the measured result for each."
  canonical="https://sebinshaiju.com/projects"
  here="projects"
>
  <section style="border-top:0; padding-top:52px;">
    <div class="wrap">
      <h1 class="sec-head" style="font-size:38px;">Projects</h1>
      <p class="lede">Nine builds, ordered newest first. The ones with a metric attached are the ones where I measured something; the rest are honest about being unmeasured.</p>

      <div class="filters" id="filters">
        <button aria-pressed="true" data-tag="all">Everything</button>
        <button aria-pressed="false" data-tag="agents">Agents &amp; LLM systems</button>
        <button aria-pressed="false" data-tag="ml">Machine learning</button>
        <button aria-pressed="false" data-tag="fullstack">Full-stack</button>
        <button aria-pressed="false" data-tag="research">Research</button>
      </div>

      <div class="rows" id="rows">
        {projects.map((project) => {
          const firstLink = project.data.links?.[0];
          const href = project.data.hasPage
            ? `/projects/${project.data.slug}`
            : firstLink?.url;
          return (
            <Row
              name={project.data.title}
              flag={project.data.flag}
              desc={project.data.summary}
              stack={project.data.stack.join(' · ')}
              metric={project.data.metric}
              year={project.data.year}
              href={href}
              external={!project.data.hasPage && !!firstLink}
              dataTags={project.data.tags.join(' ')}
            />
          );
        })}
      </div>
      <p id="empty" style="display:none; color:var(--ink-soft); padding-top:22px;">Nothing under that tag yet.</p>
    </div>
  </section>
</Layout>

<script>
  const bar = document.getElementById('filters')!;
  const rows = [...document.querySelectorAll<HTMLElement>('#rows .row')];
  const empty = document.getElementById('empty')!;

  bar.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    const tag = btn.dataset.tag!;
    let shown = 0;
    rows.forEach((r) => {
      const ok = tag === 'all' || (r.dataset.tags ?? '').split(' ').includes(tag);
      r.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    empty.style.display = shown ? 'none' : 'block';
  });
</script>
